# Copy to .hostinger.env and fill in values from Hostinger.
# Do not commit .hostinger.env.

# Usually the domain or Hostinger server hostname.
HOSTINGER_SSH_HOST=example.hostinger.com

# Hostinger SSH/SFTP username.
HOSTINGER_SSH_USER=u123456789

# Hostinger SSH/SFTP port. Hostinger often uses 65002, but confirm in hPanel.
HOSTINGER_SSH_PORT=65002

# Target folder for https://jinmi.tech/luisa-career-direction/
HOSTINGER_REMOTE_DIR=/home/u123456789/domains/jinmi.tech/public_html/luisa-career-direction
